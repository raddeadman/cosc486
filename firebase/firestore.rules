rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write to user profile by authenticated users only
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      // Optional: Prevent updating fields that should only be set during creation
      allow update: if request.auth != null 
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email;
    }
    
    // (Optional) Create a separate collection for app-specific data
    match /app_data/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}