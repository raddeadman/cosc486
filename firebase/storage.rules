rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Media uploads - only allow reads (public access)
    match /media-uploads/{allPaths=**} {
      allow read: if true; // Public read access for uploaded media

      // Write access is handled server-side by the function
      allow write: if false;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
